{
  "name": "afanime-tg-bot",
  "type": "module",
  "version": "0.2.5",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "description": "Auto forward anime episodes from NEP ani library.",
  "author": "Flynn Cao",
  "license": "MIT",
  "imports": {
    "#root/*": "./src/*"
  },
  "main": "./dist/start.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node dist/start.js",
    "dev": "tsx watch src/start.ts",
    "build": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/runner": "^2.0.3",
    "@js-joda/core": "^5.6.3",
    "@typegoose/typegoose": "^12.10.1",
    "axios": "^1.18.1",
    "chalk": "^5.3.0",
    "cron": "^3.3.1",
    "grammy": "^1.45.1",
    "mongodb": "~6.3.0",
    "mongoose": "^8.9.1",
    "socks-proxy-agent": "^8.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vite": "^7.3.0",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4"
    }
  }
}
